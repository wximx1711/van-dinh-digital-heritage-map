# =============================================================================
# Frontend Environment Variables (Vite)
# Set these in a .env file at the project root
# =============================================================================

# Note: The mapping subsystem uses Leaflet + OpenStreetMap.
# No API key required for maps or routing.

# =============================================================================
# Backend Environment Variables (ASP.NET Core)
# These override appsettings.Production.json values.
# Set as system environment variables or in the hosting platform's config.
# =============================================================================

# SQL Server connection string (required)
ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=VanDinhDigitalMap;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False

# Allowed CORS origins (space-separated or set via appsettings)
# Cors__AllowedOrigins__0=https://yourdomain.com
# Cors__AllowedOrigins__1=https://www.yourdomain.com

# Session idle timeout in hours (default: 2)
# Session__IdleTimeoutHours=2

# Auth cookie name (default: .VanDinh.Auth)
# AuthCookie__CookieName=.VanDinh.Auth

# CSRF cookie name (default: .VanDinh.Csrf)
# Csrf__CookieName=.VanDinh.Csrf

# Seed admin credentials (used on first startup to create admin user)
# WARNING: Override these via environment variables in production.
# Do not rely on appsettings.Production.json defaults.
# SeedAdmin__Username=admin
# SeedAdmin__Password=your_secure_admin_password
# SeedAdmin__FullName=System Administrator
# SeedAdmin__Email=admin@vandinh.gov.vn

# ASP.NET Core environment (set to Production in production)
ASPNETCORE_ENVIRONMENT=Production
